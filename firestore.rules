rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hjelpefunksjoner for å forenkle reglene
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Sjekker om brukeren er autentisert OG har rollen 'admin' i brukeroversikten
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEmployee() {
      // Sjekker om brukeren er autentisert OG har rollen 'employee' i brukeroversikten
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';
    }

    function isOwner(userId) {
      // Sjekker om den autentiserte brukeren er eieren av dokumentet
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail(email) {
      // Validerer at strengen er en gyldig e-post
      return email is string && email.matches('.*@.*\\..*');
    }

    function isValidWeekNumber(week) {
      // Validerer at ukenummeret er et gyldig heltall mellom 1 og 53
      return week is int && week >= 1 && week <= 53;
    }

    // --- Samling: users ---
    match /users/{userId} {
      // Kun eieren eller en administrator kan lese brukerdokumentet.
      // Kilde: src/services/authService.ts:15,71 og src/contexts/AuthContext.tsx:50-51 (eier),
      // src/pages/admin/Employees.tsx:39 (admin). Ansattes navneoppslag skjer via userDirectory.
      allow read: if isAdmin() || isOwner(userId);

      // Kun administratorer kan opprette eller oppdatere brukerdokumenter
      // Dataene må inneholde 'email', 'name', 'role' og være av riktig type/format
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['email', 'name', 'role']) &&
        isValidEmail(request.resource.data.email) &&
        request.resource.data.name is string &&
        request.resource.data.role in ['admin', 'employee'];

      // Eieren kan lagre sin egen FCM-token:
      // src/hooks/useFirebaseMessaging.ts:52 (lagre) og :128 (fjerne)
      // -> src/services/userService.ts:114-137 (fcmToken + updatedAt)
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'updatedAt']) &&
        ('fcmToken' in request.resource.data) &&
        (request.resource.data.fcmToken == null || request.resource.data.fcmToken is string) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);

      // Kun administratorer kan slette brukerdokumenter
      allow delete: if isAdmin();
    }

    // --- Samling: userDirectory ---
    // Felles navneoppslag for ansatte (name/role). Dokumentene synkroniseres av en
    // Cloud Function, derfor ingen allow write her.
    match /userDirectory/{userId} {
      allow read: if isEmployee() || isAdmin();
    }

    // --- Samling: locations ---
    match /locations/{locationId} {
      // Ansatte og administratorer kan lese stedsdata
      // (src/services/locationService.ts:42,61,160,210,236)
      allow read: if isEmployee() || isAdmin();

      // Kun administratorer kan slette stedsdata
      allow delete: if isAdmin();

      // Kun administratorer kan opprette stedsdata, med validering
      // (src/services/locationService.ts:20-37, kalt fra src/pages/admin/Locations.tsx:100)
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['name', 'address', 'maintenanceFrequency', 'edgeCuttingFrequency', 'startWeek']) &&
        request.resource.data.name is string &&
        request.resource.data.address is string &&
        request.resource.data.maintenanceFrequency is int &&
        request.resource.data.maintenanceFrequency > 0 &&
        request.resource.data.edgeCuttingFrequency is int &&
        request.resource.data.edgeCuttingFrequency > 0 &&
        isValidWeekNumber(request.resource.data.startWeek);

      // Administratorer kan oppdatere alle felt
      // (src/services/locationService.ts:96-136, kun admin-skjermer)
      allow update: if isAdmin();

      // Ansatte kan kun oppdatere feltene som addTimeEntry-transaksjonen skriver
      // (src/services/timeEntryService.ts:55-64, kalt fra src/pages/employee/TimeEntry.tsx:216;
      // utvidet med by/at-feltene etter avklaring med koordinator).
      // Direkte locationService.updateLocation brukes kun fra admin (src/pages/admin/Locations.tsx:107).
      allow update: if isEmployee() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMaintenanceWeek', 'lastEdgeCuttingWeek', 'lastMaintenanceBy', 'lastEdgeCuttingBy', 'lastMaintenanceAt', 'lastEdgeCuttingAt', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMaintenanceWeek']) == false ||
         isValidWeekNumber(request.resource.data.lastMaintenanceWeek)) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastEdgeCuttingWeek']) == false ||
         isValidWeekNumber(request.resource.data.lastEdgeCuttingWeek)) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMaintenanceBy']) == false ||
         (request.resource.data.lastMaintenanceBy is string && request.resource.data.lastMaintenanceBy == request.auth.uid)) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastEdgeCuttingBy']) == false ||
         (request.resource.data.lastEdgeCuttingBy is string && request.resource.data.lastEdgeCuttingBy == request.auth.uid)) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMaintenanceAt']) == false ||
         request.resource.data.lastMaintenanceAt is timestamp) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastEdgeCuttingAt']) == false ||
         request.resource.data.lastEdgeCuttingAt is timestamp);
    }

    // --- Samling: timeEntries ---
    match /timeEntries/{entryId} {
      // Kun administratorer, eieren av registreringen eller en tagget ansatt kan lese den.
      // Klientqueries verifisert: src/pages/employee/History.tsx:64 (employeeId == uid),
      // src/services/timeEntryService.ts:351 (array-contains egen uid) og
      // src/pages/admin/Dashboard.tsx:46,63 (admin).
      allow read: if isAdmin() ||
        request.auth.uid == resource.data.employeeId ||
        request.auth.uid in resource.data.get('taggedEmployeeIds', []);

      // Ansatte kan opprette egne tidsregistreringer.
      // Feltene matcher src/services/timeEntryService.ts:48-53 fra
      // src/pages/employee/TimeEntry.tsx:216-222 og src/components/notifications/TimeEntryDialog.tsx:77-85.
      allow create: if (isEmployee() || isAdmin()) &&
        request.resource.data.keys().hasAll(['locationId', 'employeeId', 'hours', 'date']) &&
        request.resource.data.keys().hasOnly(['locationId', 'employeeId', 'employeeName', 'hours', 'date', 'edgeCuttingDone', 'mowerId', 'notes', 'taggedEmployeeIds', 'createdAt']) &&
        request.resource.data.employeeId == request.auth.uid &&
        request.resource.data.locationId is string &&
        request.resource.data.hours is number &&
        request.resource.data.hours > 0 &&
        request.resource.data.hours <= 24 &&
        request.resource.data.date is timestamp &&
        request.resource.data.date >= request.time - duration.value(48, 'h') &&
        request.resource.data.date <= request.time + duration.value(48, 'h') &&
        request.resource.data.get('taggedEmployeeIds', []) is list &&
        request.resource.data.get('taggedEmployeeIds', []).size() <= 20 &&
        request.resource.data.get('notes', '') is string &&
        request.resource.data.get('notes', '').size() <= 2000 &&
        request.resource.data.get('employeeName', '') is string &&
        (request.resource.data.get('mowerId', null) == null ||
         request.resource.data.get('mowerId', null) is string) &&
        request.resource.data.get('edgeCuttingDone', false) is bool &&
        request.resource.data.get('createdAt', null) == request.time;

      // Kun administratorer kan oppdatere eller slette tidsregistreringer
      allow update, delete: if isAdmin();

      // En tagget ansatt kan kun endre taggelisten
      // (src/services/timeEntryService.ts:326-346 tagEmployeeForTimeEntry)
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.get('taggedEmployeeIds', []) &&
        request.resource.data.get('taggedEmployeeIds', []) is list &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taggedEmployeeIds', 'updatedAt']);
    }

    // --- Samling: mowers ---
    match /mowers/{mowerId} {
      // Ansatte og administratorer kan lese klipperdata
      // (src/services/equipmentService.ts:47-102, brukt av employee- og admin-skjermer)
      allow read: if isEmployee() || isAdmin();

      // Kun administratorer kan slette klipperdata
      allow delete: if isAdmin();

      // Kun administratorer kan opprette klipperdata, med validering
      // (src/services/equipmentService.ts:19-45)
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['name', 'model', 'serialNumber']) &&
        request.resource.data.name is string &&
        request.resource.data.model is string &&
        request.resource.data.serialNumber is string;

      // Administratorer kan oppdatere alle felt.
      // Ansatte kan kun øke 'totalHours' og oppdatere 'updatedAt':
      // src/services/equipmentService.ts:141-155 (logMowerUsage) og
      // src/services/timeEntryService.ts:66-73 (addTimeEntry-transaksjonen). Maks +24 per skriving.
      allow update: if isAdmin() ||
        (isEmployee() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalHours', 'updatedAt']) &&
          request.resource.data.totalHours is number &&
          request.resource.data.totalHours >= resource.data.totalHours &&
          request.resource.data.totalHours <= resource.data.totalHours + 24);
    }

    // --- Samling: serviceIntervals ---
    match /serviceIntervals/{intervalId} {
      // Ansatte og administratorer kan lese serviceintervaller
      // (src/services/equipmentService.ts:60-96)
      allow read: if isEmployee() || isAdmin();

      // Kun administratorer kan slette serviceintervaller
      allow delete: if isAdmin();

      // Kun administratorer kan opprette serviceintervaller, med validering
      // (src/services/equipmentService.ts:30-42 og :208-218)
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['mowerId', 'description', 'hourInterval']) &&
        request.resource.data.mowerId is string &&
        request.resource.data.description is string &&
        request.resource.data.hourInterval is int &&
        request.resource.data.hourInterval > 0;

      // Tilbakestilling skriver kun disse feltene
      // (src/services/equipmentService.ts:190-196, kalt fra employee- og admin-skjermer)
      allow update: if (isEmployee() || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastResetHours', 'lastResetDate', 'lastResetBy']) &&
        request.resource.data.lastResetHours is number &&
        request.resource.data.lastResetHours >= 0 &&
        request.resource.data.lastResetDate is timestamp &&
        request.resource.data.lastResetBy is string;
    }

    // --- Samling: serviceLogs ---
    match /serviceLogs/{logId} {
      // Ansatte og administratorer kan lese service logger
      allow read: if isEmployee() || isAdmin();

      // Kun egen utførelse kan logges. Klienten må skrive performedBy = uid
      // (src/services/equipmentService.ts:199-205, kalt fra src/pages/employee/Dashboard.tsx:128
      // og src/pages/admin/Equipment.tsx:89).
      allow create: if (isEmployee() || isAdmin()) &&
        request.resource.data.keys().hasAll(['mowerId', 'serviceIntervalId', 'performedBy', 'hoursAtService', 'date']) &&
        request.resource.data.keys().hasOnly(['mowerId', 'serviceIntervalId', 'performedBy', 'hoursAtService', 'date']) &&
        request.resource.data.mowerId is string &&
        request.resource.data.serviceIntervalId is string &&
        request.resource.data.performedBy is string &&
        request.resource.data.performedBy == request.auth.uid &&
        request.resource.data.hoursAtService is number &&
        request.resource.data.hoursAtService > 0 &&
        request.resource.data.hoursAtService <= 100000 &&
        request.resource.data.date == request.time;

      // Kun administratorer kan oppdatere eller slette service logger
      allow update, delete: if isAdmin();
    }

    // --- Samling: notifications ---
    match /notifications/{notificationId} {
      // Brukere kan bare lese sine egne varsler
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Administratorer kan opprette varsler til hvem som helst
      // (src/pages/admin/Employees.tsx:88-96 og :119-124, uten timeEntryId)
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['userId', 'title', 'message']) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.message is string;

      // Ansatte kan bare varsle en ansatt de selv har tagget i sin egen tidsregistrering
      // (src/pages/employee/TimeEntry.tsx:228-239)
      allow create: if isEmployee() &&
        request.resource.data.keys().hasAll(['userId', 'title', 'message', 'data', 'read', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['userId', 'title', 'message', 'type', 'data', 'read', 'createdAt']) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.data.get('timeEntryId', '') is string &&
        request.resource.data.data.get('timeEntryId', '') != '' &&
        exists(/databases/$(database)/documents/timeEntries/$(request.resource.data.data.get('timeEntryId', ''))) &&
        get(/databases/$(database)/documents/timeEntries/$(request.resource.data.data.get('timeEntryId', ''))).data.employeeId == request.auth.uid &&
        request.resource.data.userId in get(/databases/$(database)/documents/timeEntries/$(request.resource.data.data.get('timeEntryId', ''))).data.get('taggedEmployeeIds', []);

      // Brukere kan bare oppdatere sine egne varsler (f.eks. markere som lest)
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Kun administratorer kan slette varsler
      allow delete: if isAdmin();
    }

    // --- Samling: season_settings ---
    match /season_settings/{settingId} {
      // Ansatte og administratorer kan lese sesonginnstillinger
      // (src/services/seasonSettingsService.ts:17-48)
      allow read: if isEmployee() || isAdmin();

      // Kun administratorer kan slette sesonginnstillinger
      allow delete: if isAdmin();

      // Kun administratorer kan opprette/oppdatere, og valideringen håndheves nå
      // (tidligere gjorde "allow create, update, delete: if isAdmin()" valideringen død)
      // Kilde: src/services/seasonSettingsService.ts:50-87, src/pages/admin/Settings.tsx:42-48
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['startWeek', 'endWeek', 'defaultFrequency']) &&
        isValidWeekNumber(request.resource.data.startWeek) &&
        isValidWeekNumber(request.resource.data.endWeek) &&
        request.resource.data.startWeek < request.resource.data.endWeek &&
        request.resource.data.defaultFrequency is int &&
        request.resource.data.defaultFrequency > 0;
    }

    // --- Nekt tilgang til andre samlinger/dokumenter som ikke er eksplisitt definert ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}